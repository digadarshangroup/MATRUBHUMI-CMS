# Matrubhoomi HRMS — backend environment
#
# Copy to `.env` and fill in. Nothing here has a real value committed: `.env`
# is gitignored and must stay that way.

# ── Core ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/matrubhoomi_hrms

# Signs every session token. Any long random string; changing it signs
# everyone out. NEVER ship the default that server code falls back to.
JWT_SECRET=
JWT_EXPIRE=7d

# Origins allowed to call this API, comma-separated. localhost:3000 and :3001
# are already built in — put LAN addresses, tunnels and deployed frontends here
# rather than editing server.js. An unlisted origin fails with an opaque
# "Not allowed by CORS" and nothing in the logs points at this line.
EXTRA_ALLOWED_ORIGINS=

# The bootstrap CEO account, created only when no CEO exists at all. Sign in
# once and change the password from the app; these are not read again after.
CEO_SEED_EMAIL=ceo@matrubhoomifarms.in
CEO_SEED_PASSWORD=

# ── Payroll ─────────────────────────────────────────────────────────────
# Encrypts salary fields at rest. LOSING THIS MAKES EVERY STORED SALARY
# UNREADABLE — back it up somewhere other than this file.
SALARY_ENCRYPTION_KEY=

# ── Email (Brevo) ───────────────────────────────────────────────────────
# Used for password-reset OTPs, leave notifications and payslip delivery.
# With ENABLE_EMAILS=false the app runs fine and simply sends nothing.
ENABLE_EMAILS=false
BREVO_API_KEY=
CUSTOMER_SENDER_EMAIL=
CUSTOMER_SENDER_NAME=Matrubhoomi Farms & Developers
WEBSITE_URL=http://localhost:3000

# ── Push notifications (optional) ───────────────────────────────────────
# Firebase Admin, for the employee mobile app. Leave blank and push is simply
# disabled — every call site already degrades to a no-op with a warning.
# FIREBASE_SERVICE_ACCOUNT must be the whole service-account JSON on ONE line.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Web push (browser notifications). Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Document storage (optional) ─────────────────────────────────────────
# Google Drive service account for generated letters and payslips.
# GOOGLE_SERVICE_ACCOUNT_KEY is the service-account JSON on ONE line.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# ── Biometric attendance device (optional) ──────────────────────────────
# The punch-machine vendor API the hourly attendance sync reads from. Leave
# blank to run on manually entered attendance only.
TEAMOFFICE_BASE_URL=
TEAMOFFICE_CORP_ID=
TEAMOFFICE_USERNAME=
TEAMOFFICE_PASSWORD=
BIOMETRIC_SYNC_INTERVAL_MINUTES=60

# ── Employee app version gate ───────────────────────────────────────────
APP_LATEST_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
APP_UPDATE_URL=

# ── Sales: SMS for the customer OTP (optional) ──────────────────────────
# The one signal a field employee cannot manufacture is a code arriving on the
# farmer's own handset. With NO provider configured the flow still works: the
# server hands the code back to the EMPLOYEE to read out, and records the row
# as delivery.status "manual" — a real but visibly weaker proof. Configure a
# provider and every record after that reads "sent", with nothing else changing.
#
# SMS_PROVIDER=msg91   → MSG91_AUTH_KEY, MSG91_SENDER_ID, MSG91_TEMPLATE_ID
# SMS_PROVIDER=twilio  → TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SALES_OTP_TTL_MINUTES=10
SALES_OTP_COOLDOWN_SECONDS=45

# ── Sales: the field team's location trail ──────────────────────────────
# Cadence is served to the Android app from /api/field/bootstrap, so the whole
# fleet's battery behaviour is retuned here rather than by shipping an APK.
FIELD_TRACKING_ENABLED=true
FIELD_PING_INTERVAL_S=20          # while moving
FIELD_IDLE_INTERVAL_S=120         # after five minutes of stillness
FIELD_MIN_DISTANCE_M=15           # no fix recorded until the phone moves this far
FIELD_BATCH_SIZE=20               # fixes per upload
FIELD_BATCH_INTERVAL_S=120

# How travel is COUNTED. Fixes outside these bounds are still stored — they are
# simply not allowed to contribute distance, so the figure under-reports rather
# than inventing travel. See services/fieldTracking.js.
FIELD_ACCURACY_LIMIT_M=75         # a vaguer fix contributes nothing
FIELD_SPEED_LIMIT_KMPH=150        # a step implying more than this is a bad fix
FIELD_STOP_MINUTES=5              # staying put this long becomes a "stop" on the map
FIELD_STOP_RADIUS_M=60
FIELD_PATH_MAX_POINTS=600         # after Douglas-Peucker simplification
FIELD_PATH_TOLERANCE_M=15
FIELD_STALE_MINUTES=15            # after this, the live board says "not reporting"
FIELD_TIMEZONE=Asia/Kolkata

# Raw fixes are dropped after this many days. The DAY ROLLUP (distance, hours,
# the simplified path) is computed at ingest and kept forever, so deleting the
# trail never loses the answer anybody actually asks.
FIELD_PING_TTL_DAYS=90

# When yesterday's unfinished assignments are closed out (IST).
SALES_CLOSEOUT_CRON=0 2 * * *

# ── CORS during development ─────────────────────────────────────────────
# Accept ANY browser origin. For LAN testing, where the frontend's address is
# a laptop IP that changes whenever it rejoins a network.
#
# IGNORED when NODE_ENV=production — every route here authenticates with
# credentials, so a permissive CORS on a public host lets any site a signed-in
# person visits call this API as them. List the real origins in
# EXTRA_ALLOWED_ORIGINS there instead.
#
# It has NO effect on the Android app: a native client sends no Origin header,
# so CORS never applies to it. If the app cannot reach the server, look at the
# firewall, the IP and the port.
CORS_ALLOW_ALL=false

# ===============================
# Naming the places on a route
# ===============================
# The team map writes a day's travel as a line of place names. Names come from a
# reverse geocoder, cached in the geo_places collection so each coordinate is
# asked about once.
#
# Nominatim is the default because it needs no key and no billing account. Its
# usage policy is ONE REQUEST PER SECOND from an identified client, enforced by
# blocking — set GEOCODE_CONTACT to a real address someone reads. It is not
# suitable for heavy use; move to a paid provider before this serves more than a
# few hundred lookups a day.
GEOCODE_PROVIDER=nominatim          # or "none" to switch naming off entirely
GEOCODE_CONTACT=it@matrubhoomifarms.in
# GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
# GEOCODE_MIN_GAP_MS=1100           # the rate limit. Lowering it risks a ban.
# GEOCODE_MAX_LOOKUPS=12            # names fetched per screen on a cold cache
# FIELD_ITINERARY_STEP_M=5000       # how far apart the named waypoints are
