# Matrubhoomi HRMS — backend environment
#
# Copy to `.env` and fill in. Nothing here has a real value committed: `.env`
# is gitignored and must stay that way.

# ── Core ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGODB_URI=

# Signs every session token. Any long random string; changing it signs
# everyone out. MUST BE SET: half the auth paths read process.env.JWT_SECRET
# directly while only config/jwt.js has a dev fallback, so an EMPTY value
# makes the two disagree and logins fail with an opaque "invalid signature".
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Origins allowed to call this API, comma-separated. localhost:3000 and :3001
# are already built in — put LAN addresses, tunnels and deployed frontends
# here rather than editing server.js. An unlisted origin fails with an opaque
# "Not allowed by CORS" and nothing in the logs points at this line.
EXTRA_ALLOWED_ORIGINS=

# Set when the frontend and this API share a registrable domain (say
# cms.example.com and backend.example.com → .example.com). The session cookie
# then becomes FIRST-party and survives Safari's third-party cookie blocking.
COOKIE_DOMAIN=

# The bootstrap CEO account, created only when no CEO exists at all. Sign in
# once and change the password from the app; these are not read again after.
CEO_SEED_EMAIL=
CEO_SEED_PASSWORD=

# ── Payroll ─────────────────────────────────────────────────────────────
# Encrypts salary fields at rest. LOSING THIS MAKES EVERY STORED SALARY
# UNREADABLE — back it up somewhere other than this file.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALARY_ENCRYPTION_KEY=

# ── Email (Brevo) ───────────────────────────────────────────────────────
# Password-reset OTPs, leave notifications, payslip delivery.
# With ENABLE_EMAILS=false the app runs fine and simply sends nothing.
ENABLE_EMAILS=false
BREVO_API_KEY=
CUSTOMER_SENDER_EMAIL=
CUSTOMER_SENDER_NAME=
WEBSITE_URL=

# ── File and image storage (Cloudinary) ─────────────────────────────────
# THE ONLY BLOB STORE THIS PROJECT USES. Profile photos, employee documents,
# field-app media, leave and overtime attachments, HR-issued letters and the
# employee-app APK all land here. There is no Google Drive path any more.
#
# The API SECRET is server-only. It must NEVER be copied into the frontend's
# NEXT_PUBLIC_* variables — keeping signed uploads on this side is the entire
# reason it exists.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Everything that is not an image (PDFs, letters, the employee APK) is stored
# with Cloudinary delivery type "private" and served only through this API,
# which mints a signed download URL per request. Seconds that URL stays valid;
# it is used server-side and nowhere else, so it can be short.
CLOUDINARY_PRIVATE_URL_TTL_S=300

# This API's own public origin. Only a FALLBACK for building the
# /api/files/<token> links non-image documents are served through — upload
# routes derive it from the request, so this matters solely for uploads made
# outside one (a script, a cron job).
PUBLIC_API_BASE_URL=

# ── Web push (browser notifications) ────────────────────────────────────
# Standard VAPID Web Push through the `web-push` package. No Firebase, no
# FCM, no Google project.
#   npx web-push generate-vapid-keys
# Changing the public key invalidates every existing browser subscription;
# each user re-subscribes silently on their next sign-in. Leave blank and push
# is disabled — every call site degrades to a no-op with a warning.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Biometric attendance device (optional) ──────────────────────────────
# The punch-machine vendor API the hourly sync reads from. Leave blank to run
# on manually entered attendance only.
TEAMOFFICE_BASE_URL=
TEAMOFFICE_CORP_ID=
TEAMOFFICE_USERNAME=
TEAMOFFICE_PASSWORD=
BIOMETRIC_SYNC_INTERVAL_MINUTES=60

# ── Employee app version gate ───────────────────────────────────────────
APP_LATEST_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
APP_UPDATE_URL=

# ── Sales: SMS for the customer OTP (optional) ──────────────────────────
# With NO provider configured the flow still works: the server hands the code
# back to the EMPLOYEE to read out and records the row as delivery.status
# "manual" — a real but visibly weaker proof. Configure a provider and every
# record after that reads "sent", with nothing else changing.
#
# SMS_PROVIDER=msg91   → MSG91_AUTH_KEY, MSG91_SENDER_ID, MSG91_TEMPLATE_ID
# SMS_PROVIDER=twilio  → TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SALES_OTP_TTL_MINUTES=10
SALES_OTP_COOLDOWN_SECONDS=45

# ── Sales: the field team's location trail ──────────────────────────────
# Cadence is served to the Android app from /api/field/bootstrap, so the whole
# fleet's battery behaviour is retuned here rather than by shipping an APK.
FIELD_TRACKING_ENABLED=true
FIELD_PING_INTERVAL_S=20
FIELD_IDLE_INTERVAL_S=120
FIELD_MIN_DISTANCE_M=15
FIELD_BATCH_SIZE=20
FIELD_BATCH_INTERVAL_S=120

# How travel is COUNTED. Fixes outside these bounds are still stored — they
# are simply not allowed to contribute distance, so the figure under-reports
# rather than inventing travel. See services/fieldTracking.js.
FIELD_ACCURACY_LIMIT_M=75
FIELD_SPEED_LIMIT_KMPH=150
FIELD_STOP_MINUTES=5
FIELD_STOP_RADIUS_M=60
FIELD_PATH_MAX_POINTS=600
FIELD_PATH_TOLERANCE_M=15
FIELD_STALE_MINUTES=15
FIELD_TIMEZONE=Asia/Kolkata

# Raw fixes are dropped after this many days. The DAY ROLLUP (distance, hours,
# the simplified path) is computed at ingest and kept forever, so deleting the
# trail never loses the answer anybody actually asks.
FIELD_PING_TTL_DAYS=90

# When yesterday's unfinished assignments are closed out (IST).
SALES_CLOSEOUT_CRON=0 2 * * *

# ── CORS during development ─────────────────────────────────────────────
# Accept ANY browser origin, for LAN testing where the frontend's address is
# a laptop IP that changes whenever it rejoins a network.
#
# IGNORED when NODE_ENV=production — every route here authenticates with
# credentials, so a permissive CORS on a public host lets any site a signed-in
# person visits call this API as them. List the real origins in
# EXTRA_ALLOWED_ORIGINS there instead.
CORS_ALLOW_ALL=false

# ── Naming the places on a route ────────────────────────────────────────
# The team map writes a day's travel as a line of place names, from a reverse
# geocoder cached in geo_places so each coordinate is asked about once.
#
# Nominatim needs no key and no billing account. Its usage policy is ONE
# REQUEST PER SECOND from an identified client, enforced by blocking — set
# GEOCODE_CONTACT to a real address someone reads. Move to a paid provider
# before this serves more than a few hundred lookups a day.
GEOCODE_PROVIDER=nominatim
GEOCODE_CONTACT=
# GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
# GEOCODE_MIN_GAP_MS=1100
# GEOCODE_MAX_LOOKUPS=12
# FIELD_ITINERARY_STEP_M=5000
