# ===============================
.env.docker
docker-compose.override.yml
.env.bak-lan
.history/

# ===============================
# Credentials that must never be committed
# ===============================
# Nothing here reads a credential from a FILE — every secret arrives through
# the environment — but a downloaded service-account JSON or key left in the
# folder is the usual way one escapes anyway.
serviceAccount*.json
*.pem
*.key
*.p12
*.pfx
