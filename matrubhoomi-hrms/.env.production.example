# ═══════════════════════════════════════════════════════════════════════════
#  Matrubhoomi HRMS — FRONTEND, production (Vercel)
#
#  READY TO PASTE. Vercel → your project → Settings → Environment Variables →
#  "Import .env" (or paste the block below into the bulk editor), scope it to
#  Production, then redeploy. Vercel does NOT pick up a new variable until the
#  next deploy: changing one and reloading the site will look like nothing
#  happened.
#
#  This file is safe to commit: every value in it is already public. Every
#  NEXT_PUBLIC_* variable is compiled into the JavaScript the browser
#  downloads, so it is readable by anyone regardless of where it is stored.
#  NEVER put a secret — an API secret, a database URL, a private key — in a
#  NEXT_PUBLIC_* variable.
#
#  ── The one thing still to fill in ─────────────────────────────────────────
#  NEXT_PUBLIC_COMPANY_CIN is a placeholder. It prints on the letterhead of
#  every letter issued to an employee.
# ═══════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL=https://backend.matrubhumi.net
NEXT_PUBLIC_SITE_URL=https://cms.matrubhumi.net

NEXT_PUBLIC_COMPANY_NAME=Matrubhoomi Farms & Developers Pvt. Ltd.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Matrubhoomi Farms & Developers Private Limited
NEXT_PUBLIC_COMPANY_ADDRESS=Berhampur|Odisha, India
NEXT_PUBLIC_COMPANY_PLACE_OF_POSTING=Odisha
NEXT_PUBLIC_COMPANY_PHONE=+91 90406 26617
NEXT_PUBLIC_COMPANY_CIN=CHANGEME
NEXT_PUBLIC_COMPANY_EMAIL=hr@matrubhoomifarms.in
NEXT_PUBLIC_COMPANY_WEBSITE=https://cms.matrubhumi.net
NEXT_PUBLIC_COMPANY_LOGO_BASE64=

NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

SUPABASE_SNAKE_CHANNEL=
SUPABASE_PONG_CHANNEL=

# ═══════════════════════════════════════════════════════════════════════════
#  TWO THINGS TO CHECK ON THE BACKEND, or the deployed site loads and then
#  fails on every panel
# ═══════════════════════════════════════════════════════════════════════════
#
#  1. EXTRA_ALLOWED_ORIGINS must contain this app's exact origin:
#         EXTRA_ALLOWED_ORIGINS=https://cms.matrubhumi.net
#     Vercel also gives every preview deployment its own *.vercel.app host.
#     An origin that is not on that list fails with "Not allowed by CORS" and
#     nothing in the browser console points at the cause.
#
#  2. The session cookie is cross-site here (cms.matrubhumi.net calling
#     backend.matrubhumi.net), so the backend needs:
#         NODE_ENV=production        → SameSite=None; Secure
#     and both hosts must be https. Both sit under matrubhumi.net, so setting
#         COOKIE_DOMAIN=.matrubhumi.net
#     is strictly better: the cookie becomes first-party and survives Safari's
#     third-party cookie blocking. lib/authFetch.js also sends the token as an
#     Authorization header as a fallback, but do not rely on that alone.
#
# ═══════════════════════════════════════════════════════════════════════════
#  DELIBERATELY ABSENT — do not add these back
# ═══════════════════════════════════════════════════════════════════════════
#
#  NEXT_PUBLIC_FIREBASE_*        Firebase is not used. Browser push is VAPID
#                                Web Push and the public key is fetched from
#                                the backend at runtime.
#  NEXT_PUBLIC_CLOUDINARY_*      The browser no longer uploads to Cloudinary;
#                                it posts to the backend's /api/uploads.
#  CLOUDINARY_API_SECRET         Backend only. If it was ever set on Vercel,
#                                delete it there AND rotate the key in the
#                                Cloudinary console.
