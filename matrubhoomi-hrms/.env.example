# Matrubhoomi HRMS — frontend environment
#
# Copy to `.env.local` and fill in. `.env.production.example` is the same list
# with the production values already in it, ready to paste into Vercel.
#
# ⚠ EVERY NEXT_PUBLIC_* VALUE IS COMPILED INTO THE BROWSER BUNDLE. Nothing
#   secret may live in this file, in `.env.local`, or in a NEXT_PUBLIC_*
#   variable on Vercel.

# ── Where the API lives ────────────────────────────────────────────────────
# Must also appear in the backend's EXTRA_ALLOWED_ORIGINS, or every request
# fails with an opaque "Not allowed by CORS".
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── The company's own particulars ──────────────────────────────────────────
# These PRINT ON LEGAL DOCUMENTS. lib/company.js reads them; anything left
# unset falls back to a literal in that file, and two of those read
# "TO BE CONFIRMED".
#
# Reference each one as a LITERAL `process.env.NEXT_PUBLIC_…` in code. Next
# substitutes these into the client bundle by text match, so a computed
# `process.env[key]` lookup silently yields undefined in the browser.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
# Pipe-separated; one line per printed line, two lines maximum.
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PLACE_OF_POSTING=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_CIN=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_WEBSITE=
# Optional data: URI for the letterhead logo, so a generated PDF is identical
# online and offline. Blank uses the logo bundled in /public.
NEXT_PUBLIC_COMPANY_LOGO_BASE64=

# ── Maps ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── The 404 page's two games (optional, cosmetic) ──────────────────────────
SUPABASE_SNAKE_CHANNEL=
SUPABASE_PONG_CHANNEL=

# ── Nothing else is needed ─────────────────────────────────────────────────
# No Firebase: browser push is VAPID Web Push and the public key is fetched
# from the backend at runtime.
# No Cloudinary: the browser posts uploads to the backend's /api/uploads,
# which holds the credentials. CLOUDINARY_API_SECRET belongs ONLY in the
# backend's .env and must never appear here.
