# Matrubhoomi HRMS — frontend environment (local development)
#
# Copy the shape of this file into the deployment's environment. Everything
# prefixed NEXT_PUBLIC_ is compiled into the browser bundle — never put a
# secret behind that prefix.

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Company particulars ─────────────────────────────────────────────────
# These print on appointment letters, offer letters, experience and relieving
# letters, salary certificates, payslips and ID cards. See lib/company.js.
# ⚠ The two marked TO BE CONFIRMED must be set before any letter is issued.
NEXT_PUBLIC_COMPANY_NAME=Matrubhoomi Farms & Developers Pvt. Ltd.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Matrubhoomi Farms & Developers Private Limited
# Pipe-separated, one segment per printed line (two lines fit the letterhead).
NEXT_PUBLIC_COMPANY_ADDRESS=Address — TO BE CONFIRMED|Odisha, India
NEXT_PUBLIC_COMPANY_PLACE_OF_POSTING=Odisha
NEXT_PUBLIC_COMPANY_PHONE=TO BE CONFIRMED
NEXT_PUBLIC_COMPANY_CIN=TO BE CONFIRMED
NEXT_PUBLIC_COMPANY_EMAIL=hr@matrubhoomifarms.in

# The full illustrated logo as a base64 data URI, for PDF letterheads. Left
# unset, the flat mark baked into lib/brandAssets.js is used instead.
NEXT_PUBLIC_COMPANY_LOGO_BASE64=

# ── Optional integrations ───────────────────────────────────────────────
# Browser push. Leave blank and the app simply never asks for permission.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Image uploads. CLOUDINARY_API_SECRET is server-side only — no NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sales: map tiles for the field-team map ─────────────────────────────
# components/sales/TrackMap.js draws the route with no mapping library — it
# lays out {z}/{x}/{y} tiles as plain <img> elements and puts one SVG on top.
#
# The default below is OpenStreetMap's own tile server, which is fine for a
# handful of internal users and explicitly NOT fine at scale — their tile usage
# policy is clear about that. Point this at your own provider before this is
# open on twenty desks all day.
#
# Set it to an EMPTY string to turn tiles off entirely: the route, the stops and
# the scale bar still draw, on a plain ruled ground, with no external requests.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
